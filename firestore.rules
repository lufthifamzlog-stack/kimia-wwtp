rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data tiap tim ada di workspaces/<ID tim>/chemicals dan /transactions.
    // Hanya aplikasi yang sudah login (anonim) dan tahu ID tim yang bisa membaca/menulis.
    match /workspaces/{ws}/{col}/{doc} {
      allow read, write: if request.auth != null
                         && ws.size() >= 8
                         && col in ['chemicals', 'transactions'];
    }
  }
}
